# Dependencies
node_modules/

# Build output
out/
dist/

# Environment
.env
.env.local

# Editor/OS
.DS_Store
*.log

# Capacitor sync artifacts (regenerated by `npm run cap:sync`)
android/app/src/main/assets/public/
ios/App/App/public/

# Testing
coverage/
playwright-report/
test-results/

# Claude Code local tool config -- settings.local.json accumulates a
# command-permission allowlist that can include literal command text
# from past sessions (e.g. curl invocations with embedded bearer
# tokens used for testing), so it must never be committed.
.claude/

# Supabase CLI local session cache -- reflects whichever project you
# currently have linked locally (ref, service versions, pooler URL) and
# is not something to share; every teammate links their own target
# project, and this was previously committed, which meant re-linking
# to a different project always showed as a spurious diff.
supabase/.temp/
supabase/supabase/

