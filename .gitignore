# Dependencies
node_modules/

# Build output
out/
dist/

# Environment
.env
.env.local

# Vercel CLI local link state (`vercel link` writes org/project IDs here) --
# not secret by itself, but machine-specific and never meant to be committed.
.vercel/

# Firebase native config / credentials (see PUSH_SETUP.md). google-services.json
# and GoogleService-Info.plist identify the Firebase project to the mobile apps;
# *.p8 is an APNs auth key and is a real secret.
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
*.p8

# Editor/OS
.DS_Store
*.log

# IDE-local project state (IntelliJ/Android Studio, Xcode) -- machine-specific,
# regenerated on open, would just create merge noise between teammates.
.idea/
*.xcuserstate
xcuserdata/

# Capacitor sync artifacts (regenerated by `npm run cap:sync`)
android/app/src/main/assets/public/
ios/App/App/public/

# Testing
coverage/
playwright-report/
test-results/

# Claude Code local tool config -- settings.local.json accumulates a
# command-permission allowlist that can include literal command text
# from past sessions (e.g. curl invocations with embedded bearer
# tokens used for testing), so it must never be committed.
.claude/

# Supabase CLI local session cache -- reflects whichever project you
# currently have linked locally (ref, service versions, pooler URL) and
# is not something to share; every teammate links their own target
# project, and this was previously committed, which meant re-linking
# to a different project always showed as a spurious diff.
supabase/.temp/
supabase/supabase/

.vercel
.env*
