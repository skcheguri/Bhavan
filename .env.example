# ============================================================
# Environment variables reference for Bhavan.
#
# Vars prefixed VITE_PUBLIC_ go in this project's own .env file (read by
# the Vite client at build/dev time via import.meta.env).
#
# All other vars are Supabase Edge Function secrets -- they do NOT go in
# a .env file here. Set them on the linked Supabase project with:
#   supabase secrets set NAME=value
# ============================================================

# ---- Build (vite.config.ts) ----
# Node-level env var (not VITE_PUBLIC_-prefixed, and not read via
# import.meta.env) read directly by vite.config.ts at build time to set
# the app's base path -- passed through to the client as the __BASE_PATH__
# global and used as BrowserRouter's `basename` in App.tsx. Only needed
# when deploying under a subpath (e.g. https://host/some-subpath/);
# defaults to "/" if unset. Set this in your shell/CI environment, not
# in the .env file the Vite client loads (it's read by the config file
# itself, before Vite's own env loading applies).
BASE_PATH=

# ---- Supabase (client) ----
# Project URL, from Supabase dashboard -> Settings -> API.
VITE_PUBLIC_SUPABASE_URL=

# Public anon key, from Supabase dashboard -> Settings -> API. Safe to
# expose client-side -- RLS policies (and the users_public view / RPCs)
# are what actually restrict access, not secrecy of this key.
VITE_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase (Edge Functions runtime) ----
# Auto-provided by the Supabase Edge Function runtime -- do not set
# these yourself via `supabase secrets set`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS entirely and can call the Auth Admin API -- used only by
# admin-suspend-user (see supabase/functions/admin-suspend-user/index.ts)
# to actually ban/unban a user via auth.admin.updateUserById(). Never
# expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Aadhaar verification (supabase/functions/aadhaar-verify) ----
# UIDAI doesn't allow direct e-KYC access for arbitrary apps -- this
# proxies to a licensed third-party KYC provider (Surepass, Cashfree
# Verification Suite, Digio, HyperVerge, IDfy, etc). See the provider
# adapter block in aadhaar-verify/index.ts if switching providers.
AADHAAR_PROVIDER_BASE_URL=
AADHAAR_PROVIDER_API_KEY=

# ---- Razorpay payments (supabase/functions/create-rent-payment-order,
# supabase/functions/verify-rent-payment) ----
# From the Razorpay Dashboard -> Settings -> API Keys. Test-mode keys
# (rzp_test_*) work immediately; live-mode keys (rzp_live_*) require
# Razorpay's KYC review. The Orders/Payments APIs these functions call
# are enabled by default -- Subscriptions (a separate product, used for
# a future owner-subscription-billing flow) is not and isn't needed here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Phone OTP / MSG91 SMS (supabase/functions/send-sms-hook) ----
# Wired as a Supabase Auth "Send SMS" hook -- Supabase still generates
# and verifies the OTP itself; this only delivers the SMS via MSG91.
# See send-sms-hook/README.md for the full dashboard setup steps.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
# Variable name your MSG91 DLT template uses for the OTP placeholder
# (check the template's detail page in the MSG91 dashboard). Defaults
# to "OTP" in code if unset.
MSG91_OTP_VAR_NAME=
# Signing secret Supabase generates when you enable the Send SMS hook
# (Authentication -> Hooks). Format: v1,whsec_xxxxxxxxxxxx
SEND_SMS_HOOK_SECRET=

# ---- Testing (e2e/auth.spec.ts) ----
# Optional. Credentials for a dedicated seeded test tenant account (see
# e2e/README.md) -- the real-login E2E test skips itself cleanly when
# these aren't set, so they're not required to run the rest of the suite.
E2E_TENANT_EMAIL=
E2E_TENANT_PASSWORD=
