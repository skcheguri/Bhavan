<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google OAuth redirect. The consent page runs in the system
                 browser (Google blocks it in the WebView); Supabase then
                 redirects to com.bhavan.app://auth/callback, and this
                 filter reopens the app on that URL. singleTask (above)
                 delivers it to the running instance, where
                 useNativeOAuthCallback establishes the session. The scheme
                 must also be in Supabase's Redirect URL allow-list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.bhavan.app" android:host="auth" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications. POST_NOTIFICATIONS is required from Android 13
         (API 33); without it the permission request silently resolves to
         denied and no notification is ever shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "Search near me" on the listings page. Coarse is enough for a
         20km radius search; declaring FINE as well lets the OS offer the
         precise option, and the user can still choose approximate. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Listing photos. CAMERA is required by @capacitor/camera; without it
         the plugin's permission request resolves to denied and the camera
         never opens. READ_MEDIA_IMAGES is the Android 13+ replacement for
         READ_EXTERNAL_STORAGE, which is kept (capped) so gallery picking
         still works on older devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>
