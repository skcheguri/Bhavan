# Copy to android/keystore.properties and fill in. That file is gitignored,
# along with *.jks and *.keystore -- keep it that way.
#
# Create the upload key (once, ever):
#
#   keytool -genkeypair -v -keystore bhavan-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias bhavan
#
# Run it from somewhere OUTSIDE this repo. `storeFile` below is resolved
# relative to the android/ directory, so an absolute path is safest.
#
# READ THIS BEFORE YOU GENERATE IT: Play identifies the app by this key
# forever. Lose it and you cannot ship an update to existing installs --
# not with a support ticket, not with a new key. You would have to publish
# a new listing and abandon every install and review. Back it up somewhere
# that survives a dead laptop, and store the passwords in a password
# manager, not here.
#
# Enrolling in Play App Signing (recommended, and the default for new apps)
# means Google holds the *signing* key and this becomes the *upload* key,
# which Google can reset if you lose it. That materially reduces the blast
# radius -- do it.
#
# With this file absent, release builds still compile; they just come out
# unsigned and cannot be uploaded.

storeFile=C:/keys/bhavan-upload.jks
storePassword=
keyAlias=bhavan
keyPassword=
